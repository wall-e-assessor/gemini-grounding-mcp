# Copie este arquivo para ".env" e preencha com a SUA chave.
# NUNCA faça commit do arquivo .env real (ele está no .gitignore).

# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui

# (Opcional) Modelo do Gemini. Padrão: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
